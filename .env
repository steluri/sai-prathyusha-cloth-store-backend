# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Use "local" for development or "s3" for an S3-compatible object store.
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=10

# Required when STORAGE_BACKEND=s3.
OBJECT_STORAGE_BUCKET=pandu-product-images
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_ADDRESSING_STYLE=auto

# Set strong, unique values in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_MAX_AGE=43200

# Use "console" locally or "ses" to send OTP email through AWS SES.
OTP_EMAIL_BACKEND=ses
SES_FROM_EMAIL=srikanthreddyteluri@gmail.com

# Use "console" locally or "sns" for SMS order status updates.
SMS_BACKEND=sns
ORDER_STATUS_SNS_TOPIC_ARN=arn:aws:sns:ap-south-2:457778953062:Order-status-topic
OTP_SECRET=change-me-to-another-long-random-secret
OTP_EXPIRY_SECONDS=300
OTP_VERIFICATION_TOKEN_SECONDS=1800
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
AWS_REGION=ap-south-1

# Configure SES_FROM_EMAIL as a verified sender in SES in AWS_REGION.

# Razorpay test or live API keys. Keep the secret on the backend only.
RAZORPAY_KEY_ID=rzp_test_TeAvehlbogcn63
RAZORPAY_KEY_SECRET=IDRyHbhPSlGKXj6mOzj8FlnX
